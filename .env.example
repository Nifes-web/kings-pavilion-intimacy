# King's Pavilion Intimacy Prayer Bootcamp Platform
# Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO REPOSITORY OR PUBLIC CODE

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_EVENT_NAME="Intimacy"
NEXT_PUBLIC_EVENT_DATE="2026-12-05"
NEXT_PUBLIC_EVENT_TIME="08:00"
NEXT_PUBLIC_EVENT_TIMEZONE="Africa/Lagos"

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Required in Phase 3)
# -----------------------------------------------------------------------------
# Public URL and Anonymous Key for client-side and public data fetching
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Secret Service Role Key - STRICTLY SERVER-SIDE ONLY (API routes, migrations, background jobs)
# NEVER prefix with NEXT_PUBLIC_ or expose in browser bundles
SUPABASE_SERVICE_ROLE_KEY=your-server-side-service-role-key-here

# Direct PostgreSQL connection string for running migrations (dev only, never used at runtime)
# Find in Supabase Dashboard → Project Settings → Database → Connection string → URI
# Format: postgresql://postgres.PROJECT_REF:[DB_PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:[DB_PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# -----------------------------------------------------------------------------
# RESEND EMAIL CONFIGURATION (Required in Phase 7)
# -----------------------------------------------------------------------------
# Protected server-side API Key for Resend
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL="King's Pavilion Intimacy <notifications@yourverifieddomain.org>"

# -----------------------------------------------------------------------------
# ADMINISTRATIVE NOTIFICATION RECIPIENT
# -----------------------------------------------------------------------------
MAIN_ADMIN_NOTIFICATION_EMAIL=admin@yourverifieddomain.org
PASTOR_ACCOUNT_EMAIL=pastor@yourverifieddomain.org

